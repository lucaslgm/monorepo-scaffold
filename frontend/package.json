{
  "name": "monorepo-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "pnpm concurrently \"pnpm dev:build\" \"pnpm dev:serve\"",
    "start:standalone": "vite --port 9000",
    "build": "vite build",
    "standalone": "vite --mode=standalone --port 9000",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "oxlint",
    "check-format": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky",
    "dev:build": "vite build --mode=development --watch",
    "dev:serve": "serve -s build -p 9012 -C"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    
    "@tanstack/react-query": "5.100.11",
    "@tanstack/react-query-devtools": "5.100.11",
    "fabric": "7.4.0",
    "jspdf": "4.2.1",
    "pdfjs-dist": "^5.7.284",
    "react-hook-form": "^7",
    "react-router-dom": "7.15.1",
    "react-use": "17.6.0",
    "single-spa": "6.0.3",
    "single-spa-react": "6.0.2",
    "styled-components": "6.4.2",
    "use-context-selector": "2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",

    "@playwright/test": "1.60.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/fabric": "^5.3.11",
    "@types/react-router-dom": "5.3.3",
    "@types/systemjs": "6.15.4",
    "@vitejs/plugin-react-swc": "4.3.1",
    "autoprefixer": "10.5.0",
    "axios": "1.16.1",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "husky": "9.1.7",
    "identity-obj-proxy": "3.0.0",
    "jsdom": "29.1.1",
    "oxlint": "1.66.0",
    "prettier": "3.8.3",
    "pretty-quick": "4.2.2",
    "sass-embedded": "1.99.0",
    "serve": "^14.2.6",
    "ts-config-single-spa": "3.0.0",
    "vitest": "4.1.7"
  }
}