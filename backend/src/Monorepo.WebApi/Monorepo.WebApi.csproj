<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Define o namespace raiz padrão para o projeto, usado na geração de código e organização das
    classes.-->
    <RootNamespace>Monorepo.WebApi</RootNamespace>

    <!-- Especifica que o projeto não usará globalização invariante, permitindo suporte a culturas
    específicas do sistema operacional.-->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!--Define
    o sistema operacional padrão de destino para builds Docker como Linux. -->
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

    <!-- Indica que o projeto gera um executável (aplicação), e não uma biblioteca. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Autofac" Version="9.1.0" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="CSharpFunctionalExtensions" Version="3.7.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.15.2-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.15.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore"
      Version="1.15.0-beta.1" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Monorepo.Domain\Monorepo.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Features\**\*.sql" />
    <EmbeddedResource Include="Shared\**\*.sql" />
  </ItemGroup>

</Project>